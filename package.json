{
    "name": "full-stack-template",
    "private": true,
    "workspaces": {
        "packages": [
            "apps/*",
            "packages/*"
        ],
        "catalog": {
            "zod": "^4.6.7",
            "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
            "@types/bun": "^1.4.4",
            "varlock": "1.25.0",
            "@orpc/server": "^1.16.2",
            "@orpc/openapi": "^1.16.2",
            "@orpc/zod": "^1.16.2",
            "better-auth": "1.7.22",
            "@tanstack/react-query": "^5.107.1",
            "lucide-react": "^1.72.0",
            "next-themes": "^0.4.6",
            "sonner": "^2.0.8",
            "tailwindcss": "^4.3.5",
            "@orpc/tanstack-query": "^1.16.2",
            "@orpc/client": "^1.16.2",
            "@tanstack/react-form": "^1.33.5",
            "@polar-sh/better-auth": "^2.1.4",
            "@types/react-dom": "^19.3.0",
            "@better-auth/expo": "1.7.22",
            "drizzle-orm": "1.0.0-rc.5"
        }
    },
    "type": "module",
    "scripts": {
        "dev": "vp run -r dev",
        "build": "vp run -r build",
        "check-types": "vp run -r check-types",
        "check": "vp check && vp run -r check-types",
        "lint": "vp lint",
        "format": "vp fmt",
        "staged": "vp staged",
        "dev:native": "vp run --filter native dev",
        "dev:web": "vp run --filter web dev",
        "dev:server": "vp run --filter server dev",
        "db:push": "vp run --filter @full-stack-template/db db:push",
        "db:studio": "vp run --filter @full-stack-template/db db:studio",
        "db:generate": "vp run --filter @full-stack-template/db db:generate",
        "db:migrate": "vp run --filter @full-stack-template/db db:migrate",
        "docker:build": "docker compose build",
        "docker:up": "docker compose up -d --build",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f",
        "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
        "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
        "auth:generate": "cd apps/server && bun run auth:generate"
    },
    "dependencies": {
        "zod": "catalog:"
    },
    "devDependencies": {
        "@full-stack-template/config": "workspace:*",
        "@types/bun": "catalog:",
        "lefthook": "^2.2.2",
        "rolldown": "1.3.2",
        "typescript": "^6.0.3",
        "varlock": "catalog:",
        "vite": "catalog:",
        "vite-plus": "1.6.0"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
    },
    "packageManager": "bun@1.4.4"
}
